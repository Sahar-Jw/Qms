DB_HOST=localhost
DB_PORT=3306
DB_USER=qms
DB_PASSWORD=replace-with-database-password
DB_NAME=qms
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Technical Manager
SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Stay signed in (hours). Default 720 = 30 days; each page load renews it.
JWT_EXPIRES_HOURS=720

# Password reset e-mails (Gmail: use an App Password, port 587 + MAIL_SECURE=false, or 465 + MAIL_SECURE=true)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="QMS <your@gmail.com>"
# Public URL used inside the reset link (defaults to the first FRONTEND_URLS entry)
APP_URL=http://localhost:3000
RESET_TOKEN_MINUTES=60
